# Application environment: development, test, or production
APP_ENV=development

# mock: deterministic fixtures for tests/development
# real: M7 partial real integration; available sources are selected below
# Production is intentionally blocked until all required real providers exist.
PROVIDER_MODE=mock

# alpha_vantage: US-oriented API; requires a key.
# akshare: A-share quote/profile/financial adapters (upstream availability varies).
# sina: Sina A-share quote adapter only; profile and financials fail closed.
# sina_baostock: Sina quote + Sina annual income statement + BaoStock company metadata.
REAL_PROVIDER_SOURCE=alpha_vantage

# Required only when PROVIDER_MODE=real and REAL_PROVIDER_SOURCE=alpha_vantage.
# Never commit a real API key.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# Existing LLM settings, if needed for local execution:
# LLM_MODEL=your-model-name
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://your-compatible-endpoint/v1
